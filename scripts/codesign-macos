#!/usr/bin/env bash
# codesign-macos: sign one Mach-O binary or dylib with the Developer ID
# Application identity (hardened runtime + secure timestamp). Used by the
# Makefile's desktop-natives-darwin-* targets to sign libghostty-vt before it
# is embedded into agentd-desktop, so hardened-runtime library validation
# accepts it (same Team ID) without disable-library-validation.
#
# Environment: SIGNING_IDENTITY (or MACOS_SIGN_IDENTITY), and
# MACOS_SIGN_KEYCHAIN_PATH (+ MACOS_SIGN_KEYCHAIN_PASSWORD) as exported by
# digiogithub/ci-actions/macos-signing-keychain. agentd and agentd-desktop
# need no entitlements (no JIT, no unsigned executable memory).
#
# Adapted from Pando's scripts/codesign-macos (digiogithub/pando, MIT).
set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <mach-o-binary-or-dylib>" >&2
    exit 1
fi

TARGET="$1"
SIGNING_IDENTITY="${SIGNING_IDENTITY:-${MACOS_SIGN_IDENTITY:-}}"
KEYCHAIN_PATH="${MACOS_SIGN_KEYCHAIN_PATH:-}"
KEYCHAIN_PASSWORD="${MACOS_SIGN_KEYCHAIN_PASSWORD:-}"

if [[ -z "$SIGNING_IDENTITY" ]]; then
    echo "Error: SIGNING_IDENTITY or MACOS_SIGN_IDENTITY must be set." >&2
    exit 1
fi

KC_ARGS=()
if [[ -n "$KEYCHAIN_PATH" ]]; then
    if [[ -n "$KEYCHAIN_PASSWORD" ]]; then
        security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH" >/dev/null 2>&1 || true
    fi
    KC_ARGS=(--keychain "$KEYCHAIN_PATH")
fi

codesign --force -o runtime --timestamp ${KC_ARGS[@]+"${KC_ARGS[@]}"} --sign "$SIGNING_IDENTITY" "$TARGET"
