#!/usr/bin/env bash
# fetch-ghostty-vt: download the libghostty-vt build that agentd-desktop's
# terminal (MyGo plugins/terminal) binds, for one platform, verified against
# the SHA-256 pinned in the MyGo module's manifest.
#
# Usage:
#   scripts/fetch-ghostty-vt <goos>-<goarch> <dest-dir>
#   e.g. scripts/fetch-ghostty-vt darwin-arm64 internal/desktopui/natives/darwin-arm64
#
# Prints the path of the written library. The URL, file name and checksum come
# from plugins/terminal/mygo-plugin.json of the github.com/egoist/mygo version
# in go.mod (pinned exactly, see AGENTS.md), so the library always matches the
# bindings compiled into agentd-desktop. This script pins nothing itself.
#
# Why: the library is embedded into the agentd-desktop binary with go:embed
# (internal/desktopui/natives) so every distribution is a single file; the
# Makefile's desktop-natives-<goos>-<goarch> targets call this script into the
# embed directory before `go build` (and sign the darwin dylib there). At
# start-up agentd-desktop extracts it to <user cache>/agentd-desktop/natives/
# and points $MYGO_GHOSTTY_VT at it. The agentd CLI/daemon never embeds it.
#
# The verified download is kept in a build cache ($AGENTD_NATIVES_CACHE,
# default <user cache>/agentd-build/natives/<sha256>/), so later builds copy
# it from there and work offline. The copy in <dest-dir> is always the
# pristine download: a signature added afterwards (darwin) is applied to
# <dest-dir> only.
#
# Adapted from Pando's scripts/fetch-ghostty-vt (digiogithub/pando, MIT).
# libghostty-vt is built from Ghostty (MIT) and published by the MyGo project.

set -euo pipefail

target="${1:?usage: fetch-ghostty-vt <goos>-<goarch> <dest-dir>}"
dest="${2:?usage: fetch-ghostty-vt <goos>-<goarch> <dest-dir>}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
GO="${GO:-go}"

# go list -m reports an empty Dir until the module is in the module cache
# (fresh CI runners), so download it first.
(cd "$REPO_ROOT" && "$GO" mod download github.com/egoist/mygo)
mygo_dir="$(cd "$REPO_ROOT" && "$GO" list -m -f '{{.Dir}}' github.com/egoist/mygo)"
manifest="$mygo_dir/plugins/terminal/mygo-plugin.json"
[[ -f "$manifest" ]] || { echo "Error: $manifest not found (run 'go mod download')." >&2; exit 1; }

# name, url and sha256, one per line.
read_manifest() {
    python3 -I - "$manifest" "$target" <<'PY'
import json, sys
manifest, target = sys.argv[1], sys.argv[2]
with open(manifest) as f:
    data = json.load(f)
for lib in data.get("libraries", []):
    if lib.get("name") == "libghostty-vt" and target in lib.get("files", {}):
        f = lib["files"][target]
        print(f["name"]); print(f["url"]); print(f["sha256"])
        sys.exit(0)
sys.exit("no libghostty-vt build for " + target)
PY
}

info="$(read_manifest)"
name="$(sed -n 1p <<<"$info")"
url="$(sed -n 2p <<<"$info")"
sha="$(sed -n 3p <<<"$info")"

sha_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}

if [[ -n "${AGENTD_NATIVES_CACHE:-}" ]]; then
    cache_root="$AGENTD_NATIVES_CACHE"
elif [[ "$(uname)" == "Darwin" ]]; then
    cache_root="$HOME/Library/Caches/agentd-build/natives"
else
    cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/agentd-build/natives"
fi
cached="$cache_root/$sha/$name"

if [[ ! -f "$cached" || "$(sha_of "$cached")" != "$sha" ]]; then
    mkdir -p "$(dirname "$cached")"
    tmp="$cached.download.$$"
    trap 'rm -f "$tmp"' EXIT
    curl -fsSL --retry 3 -o "$tmp" "$url"
    got="$(sha_of "$tmp")"
    if [[ "$got" != "$sha" ]]; then
        echo "Error: SHA-256 mismatch for $url: got $got, want $sha" >&2
        exit 1
    fi
    mv "$tmp" "$cached"
fi

mkdir -p "$dest"
out="$dest/$name"
cp "$cached" "$out.tmp.$$"
chmod 0644 "$out.tmp.$$"
mv -f "$out.tmp.$$" "$out"
echo "$out"
