# Copy to android/key.properties (gitignored) for local signed release builds.
# In CI the same values come from environment variables instead:
#   ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
# storeFile is relative to the android/ directory (or absolute).
storeFile=../upload-keystore.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
